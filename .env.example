# Alpaca market-data credentials. Keep real values in a local `.env`, never in Git.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Stock feed: `iex` is commonly available; `sip` requires the matching entitlement.
ALPACA_STOCK_FEED=iex

# Informational entitlement label for historical option bars: `indicative` or `opra`.
# Alpaca's historical option-bars request does not expose a feed parameter.
ALPACA_OPTIONS_FEED=indicative

# MarketData.app Free Forever token. Personal/non-commercial use only under provider terms.
MARKETDATA_TOKEN=

# IBKR TWS/IB Gateway read-only session. IBKR does not issue an API key for this
# socket API: authenticate in TWS/Gateway, then expose only the local paper port.
OPRA_PROVIDER=ibkr_tws
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_SESSION_MODE=paper
IBKR_MARKET_DATA_TYPE=delayed

# Set these to true only after a human has verified the account subscription,
# OPRA subscriber terms, storage, and intended use. They are gates, not secrets.
OPRA_ENTITLEMENT_CONFIRMED=false
OPRA_LICENSE_REVIEWED=false

# A future non-IBKR token-based provider would use these instead. Keep blank.
# OPRA_API_KEY=
# OPRA_API_SECRET=
# OPRA_ACCOUNT_OR_SESSION=
