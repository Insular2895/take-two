TTWO_CONTROL_URL=https://take-two-control.YOUR-SUBDOMAIN.workers.dev
TTWO_BRIDGE_ID=oci-a1-paper-01
TTWO_BRIDGE_SHARED_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
CF_ACCESS_CLIENT_ID=PASTE_SERVICE_TOKEN_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=PASTE_SERVICE_TOKEN_CLIENT_SECRET
TTWO_BRIDGE_JOURNAL=/var/lib/ttwo-bridge/journal.sqlite3
TTWO_BRIDGE_POLL_SECONDS=5

# Read-only IBKR telemetry. The adapter rejects non-loopback hosts, non-paper ports,
# multiple accounts, live account identifiers, and symbols other than TTWO.
TTWO_IBKR_HOST=127.0.0.1
TTWO_IBKR_PORT=4002
TTWO_IBKR_READONLY_CLIENT_ID=901
TTWO_IBKR_TIMEOUT_SECONDS=15

# Dedicated read-only publisher credentials. Its HMAC secret is not accepted by
# intent-claim or broker-event routes.
TTWO_TELEMETRY_ID=oci-a1-paper-telemetry-01
TTWO_TELEMETRY_SHARED_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
TTWO_TELEMETRY_INTERVAL_SECONDS=30
