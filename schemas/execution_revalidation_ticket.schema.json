          "type": "object"
        },
        "quote_age_seconds": {
          "minimum": 0,
          "title": "Quote Age Seconds",
          "type": "number"
        },
        "rate_curve_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Curve Hash"
        },
        "rate_inputs_fresh": {
          "title": "Rate Inputs Fresh",
          "type": "boolean"
        },
        "required_inputs_fresh": {
          "title": "Required Inputs Fresh",
          "type": "boolean"
        },
        "signed_price_convention_verified": {
          "default": false,
          "title": "Signed Price Convention Verified",
          "type": "boolean"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "spot": {
          "exclusiveMinimum": 0,
          "title": "Spot",
          "type": "number"
        },
        "synthetic_combo_ask": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic Combo Ask"
        },
        "synthetic_combo_bid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic Combo Bid"
        },
        "ticker": {
          "pattern": "^TTWO$",
          "title": "Ticker",
          "type": "string"
        },
        "time_zone_id": {
          "minLength": 1,
          "title": "Time Zone Id",
          "type": "string"
        },
        "trading_hours": {
          "minLength": 1,
          "title": "Trading Hours",
          "type": "string"
        },
        "underlying_fresh": {
          "title": "Underlying Fresh",
          "type": "boolean"
        },
        "underlying_timestamp": {
          "format": "date-time",
          "title": "Underlying Timestamp",
          "type": "string"
        },
        "volume": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Volume",
          "type": "object"
        }
      },
      "required": [
        "snapshot_id",
        "captured_at",
        "ticker",
        "spot",
        "market_data_type",
        "underlying_timestamp",
        "leg_timestamps",
        "leg_bid_ask",
        "leg_implied_volatility",
        "provider_leg_greeks",
        "open_interest",
        "volume",
        "bid_size",
        "ask_size",
        "trading_hours",
        "liquid_hours",
        "time_zone_id",
        "quote_age_seconds",
        "underlying_fresh",
        "option_leg_freshness",
        "bag_fresh",
        "rate_inputs_fresh",
        "dividend_inputs_fresh",
        "required_inputs_fresh"
      ],
      "title": "ExecutionMarketSnapshot",
      "type": "object"
    },
