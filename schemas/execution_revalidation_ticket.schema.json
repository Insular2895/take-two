          "type": "object"
        },
        "bag_fresh": {
          "title": "Bag Fresh",
          "type": "boolean"
        },
        "bid_size": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Bid Size",
          "type": "object"
        },
        "captured_at": {
          "format": "date-time",
