        "fx_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Timestamp"
        },
        "leg_bid_ask": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Leg Bid Ask",
          "type": "object"
        },
        "leg_implied_volatility": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Leg Implied Volatility",
          "type": "object"
        },
        "leg_timestamps": {
          "additionalProperties": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Leg Timestamps",
          "type": "object"
        },
        "liquid_hours": {
          "minLength": 1,
          "title": "Liquid Hours",
          "type": "string"
        },
        "market_data_type": {
          "$ref": "#/$defs/MarketDataType"
        },
        "open_interest": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Open Interest",
          "type": "object"
        },
        "option_leg_freshness": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Option Leg Freshness",
          "type": "object"
        },
        "provider_leg_greeks": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/GreekVector"
              },
              {
                "type": "null"
              }
            ]
