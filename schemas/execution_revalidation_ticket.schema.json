            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dividend Input Hash"
        },
        "dividend_inputs_fresh": {
          "title": "Dividend Inputs Fresh",
          "type": "boolean"
        },
        "fx_fresh": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Fresh"
        },
        "fx_rate_to_eur": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
