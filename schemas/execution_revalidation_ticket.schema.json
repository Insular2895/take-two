{
  "$defs": {
    "ComboGuaranteeMode": {
      "enum": [
        "GUARANTEED",
        "NON_GUARANTEED",
        "UNKNOWN"
      ],
      "title": "ComboGuaranteeMode",
      "type": "string"
    },
    "DriftEvaluation": {
      "additionalProperties": false,
      "properties": {
        "breached_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Breached Metrics",
          "type": "array"
        },
        "observed_deltas": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Observed Deltas",
          "type": "object"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MaterialDriftStatus"
        }
      },
      "required": [
        "status",
        "policy_version",
        "observed_deltas"
      ],
      "title": "DriftEvaluation",
      "type": "object"
    },
    "ExecutionEconomicsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "breakevens": {
          "default": [],
