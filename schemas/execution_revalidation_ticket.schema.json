        "preserve_original_artifacts": {
          "default": true,
          "title": "Preserve Original Artifacts",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "original_analysis_id",
        "original_candidate_id",
        "current_market_snapshot_hash",
        "reason_codes"
      ],
      "title": "ReanalysisRequest",
      "type": "object"
    },
    "RevalidationVerdict": {
      "enum": [
        "EXECUTABLE",
        "EXECUTABLE_REPRICE_PROPOSAL",
        "REVIEW_REQUIRED",
        "REANALYSIS_REQUIRED",
        "BLOCKED"
      ],
      "title": "RevalidationVerdict",
      "type": "string"
    }
  },
  "$id": "https://schemas.take-two-options.invalid/v11.1/execution_revalidation_ticket.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automatic_repricing_allowed": {
      "default": false,
      "title": "Automatic Repricing Allowed",
      "type": "boolean"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "broker_combo_guarantee_mode": {
      "$ref": "#/$defs/ComboGuaranteeMode"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "combo_submission_mode": {
      "pattern": "^WHOLE_BAG$",
      "title": "Combo Submission Mode",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Current Config Hash",
      "type": "string"
    },
    "current_git_commit": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Current Git Commit",
      "type": "string"
    },
    "current_market": {
      "$ref": "#/$defs/ExecutionMarketSnapshot"
    },
    "current_market_snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Current Market Snapshot Hash",
      "type": "string"
    },
    "deltas": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Deltas",
      "type": "object"
    },
    "dossier_id": {
      "title": "Dossier Id",
      "type": "string"
    },
    "execution_environment": {
      "$ref": "#/$defs/ExecutionEnvironment",
      "default": "IBKR_PAPER_SIMULATOR"
    },
    "human_confirmation_required": {
      "default": true,
      "title": "Human Confirmation Required",
      "type": "boolean"
    },
    "legs": {
      "items": {
        "$ref": "#/$defs/ExecutionLegIdentity"
      },
      "title": "Legs",
      "type": "array"
    },
    "live_execution_allowed": {
      "default": false,
      "title": "Live Execution Allowed",
      "type": "boolean"
    },
    "material_drift": {
      "$ref": "#/$defs/DriftEvaluation"
    },
    "original_analysis_id": {
      "title": "Original Analysis Id",
      "type": "string"
    },
    "original_economics": {
      "$ref": "#/$defs/ExecutionEconomicsSnapshot"
    },
    "original_market": {
      "$ref": "#/$defs/ExecutionMarketSnapshot"
    },
    "original_market_snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original Market Snapshot Hash",
      "type": "string"
    },
    "original_trade_economics_ticket_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original Trade Economics Ticket Hash",
      "type": "string"
    },
    "previous_execution_ticket_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Execution Ticket Id"
    },
    "proposed_execution_economics": {
      "$ref": "#/$defs/ExecutionEconomicsSnapshot"
    },
    "proposed_limit": {
      "exclusiveMinimum": 0,
      "title": "Proposed Limit",
      "type": "number"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "reanalysis_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReanalysisRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rounded_from_limit": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rounded From Limit"
    },
    "schema_version": {
      "default": "execution-revalidation/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_id": {
      "title": "Selection Id",
      "type": "string"
    },
    "structure_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Structure Hash",
      "type": "string"
    },
    "structure_type": {
      "minLength": 1,
      "title": "Structure Type",
      "type": "string"
    },
    "ticket_id": {
      "pattern": "^execution-revalidation-[a-f0-9]{16}$",
      "title": "Ticket Id",
      "type": "string"
    },
    "valid_tick": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Tick"
    },
    "verdict": {
      "$ref": "#/$defs/RevalidationVerdict"
    }
  },
  "required": [
    "ticket_id",
    "created_at",
    "original_analysis_id",
    "candidate_id",
    "selection_id",
    "dossier_id",
    "original_trade_economics_ticket_hash",
    "original_market_snapshot_hash",
    "current_market_snapshot_hash",
    "current_git_commit",
    "current_config_hash",
    "structure_type",
    "structure_hash",
    "quantity",
    "legs",
    "proposed_limit",
    "combo_submission_mode",
    "broker_combo_guarantee_mode",
    "original_market",
    "original_economics",
    "current_market",
    "proposed_execution_economics",
    "deltas",
    "material_drift",
    "verdict",
    "blockers"
  ],
  "title": "ExecutionRevalidationTicket",
  "type": "object"
}
