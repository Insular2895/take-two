            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Broker Buying Power Requirement"
        },
        "capital_required": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Required"
        },
        "cash_flow_type": {
          "pattern": "^(DEBIT|CREDIT)$",
          "title": "Cash Flow Type",
          "type": "string"
        },
        "cvar_95": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvar 95"
        },
        "event_crush_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Crush Hash"
        },
        "expected_commissions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Commissions"
        },
        "expected_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Pnl"
        },
        "expected_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Return"
        },
        "five_scores": {
          "$ref": "#/$defs/FiveScoreSnapshot"
        },
        "flat_spot_pnl": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Flat Spot Pnl",
          "type": "object"
        },
        "fx_transaction_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Transaction Cost"
        },
        "greeks": {
          "$ref": "#/$defs/GreekVector"
        },
        "liquidity_diagnostics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Liquidity Diagnostics",
          "type": "object"
        },
        "max_loss": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Loss"
        },
        "max_profit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Profit"
        },
        "probability_loss": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Loss"
        },
        "probability_profit": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Profit"
        },
        "proposed_combo_limit": {
          "minimum": 0,
          "title": "Proposed Combo Limit",
          "type": "number"
        },
        "return_on_capital": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return On Capital"
        },
        "return_on_risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return On Risk"
        },
        "signed_entry_cash_flow": {
          "title": "Signed Entry Cash Flow",
          "type": "number"
        },
        "slippage_estimate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slippage Estimate"
        },
        "source_engine_version": {
          "minLength": 1,
          "title": "Source Engine Version",
          "type": "string"
        },
        "spot_time_iv_matrix_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spot Time Iv Matrix Hash"
        },
        "theta_per_capital_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theta Per Capital Day"
        },
        "touch_probabilities": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Touch Probabilities",
          "type": "object"
        },
        "var_95": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var 95"
        },
        "volatility_shock_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volatility Shock Hash"
        }
      },
      "required": [
        "source_engine_version",
        "proposed_combo_limit",
        "cash_flow_type",
        "signed_entry_cash_flow",
        "greeks",
        "flat_spot_pnl",
        "touch_probabilities",
        "liquidity_diagnostics",
        "five_scores"
      ],
      "title": "ExecutionEconomicsSnapshot",
      "type": "object"
    },
    "ExecutionEnvironment": {
      "enum": [
        "IBKR_PAPER_SIMULATOR"
      ],
      "title": "ExecutionEnvironment",
      "type": "string"
    },
    "ExecutionLegIdentity": {
      "additionalProperties": false,
      "properties": {
        "application_action": {
          "pattern": "^(BUY_TO_OPEN|SELL_TO_OPEN)$",
          "title": "Application Action",
          "type": "string"
        },
        "con_id": {
          "exclusiveMinimum": 0,
          "title": "Con Id",
          "type": "integer"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "minLength": 1,
          "title": "Exchange",
          "type": "string"
        },
        "expiration": {
          "pattern": "^\\d{8}$",
          "title": "Expiration",
          "type": "string"
        },
        "local_symbol": {
          "minLength": 1,
          "title": "Local Symbol",
          "type": "string"
        },
        "multiplier": {
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "integer"
        },
        "ratio": {
          "exclusiveMinimum": 0,
          "title": "Ratio",
          "type": "integer"
        },
        "right": {
          "pattern": "^[CP]$",
          "title": "Right",
          "type": "string"
        },
        "strike": {
          "exclusiveMinimum": 0,
          "title": "Strike",
          "type": "number"
        },
        "trading_class": {
          "minLength": 1,
          "title": "Trading Class",
          "type": "string"
        },
        "wire_action": {
          "pattern": "^(BUY|SELL)$",
          "title": "Wire Action",
          "type": "string"
        }
      },
      "required": [
        "con_id",
        "local_symbol",
        "trading_class",
        "expiration",
        "strike",
        "right",
        "multiplier",
        "currency",
        "exchange",
        "ratio",
        "application_action",
        "wire_action"
      ],
      "title": "ExecutionLegIdentity",
      "type": "object"
    },
    "ExecutionMarketSnapshot": {
      "additionalProperties": false,
      "properties": {
        "ask_size": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
