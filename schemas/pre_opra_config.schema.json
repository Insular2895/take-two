{
  "$defs": {
    "AdvancedGreekPolicy": {
      "additionalProperties": false,
      "properties": {
        "display_color": {
          "default": true,
          "title": "Display Color",
          "type": "boolean"
        },
        "display_speed": {
          "default": true,
          "title": "Display Speed",
          "type": "boolean"
        },
        "enabled": {
          "const": true,
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "AdvancedGreekPolicy",
      "type": "object"
    },
    "AnalysisMode": {
      "enum": [
        "screen",
        "deep_analysis"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "Architecture": {
      "enum": [
        "long_call",
        "long_put",
        "bull_call_spread",
        "bear_put_spread",
        "call_butterfly",
        "put_butterfly",
        "call_broken_wing_butterfly",
        "put_broken_wing_butterfly",
        "call_calendar",
        "put_calendar",
        "call_diagonal",
        "put_diagonal",
        "long_straddle",
        "long_strangle",
        "iron_condor"
      ],
