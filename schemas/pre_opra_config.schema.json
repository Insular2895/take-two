        "amount",
        "currency",
        "maximum_loss",
        "maximum_contracts",
        "safety_reserve_fraction"
      ],
      "title": "CapitalConstraintsConfig",
      "type": "object"
    },
    "ExecutionAssumptionsConfig": {
      "additionalProperties": false,
      "properties": {
        "commission_per_contract_side": {
          "$ref": "#/$defs/GovernedValue"
        },
        "long_entry_side": {
          "const": "ask",
          "title": "Long Entry Side",
          "type": "string"
        },
        "long_exit_side": {
          "const": "bid",
          "title": "Long Exit Side",
          "type": "string"
        },
        "order_capability": {
          "const": "forbidden",
          "title": "Order Capability",
          "type": "string"
        },
        "preview_only": {
          "const": true,
          "title": "Preview Only",
          "type": "boolean"
        },
        "quote_quality_required": {
          "enum": [
            "live_broker",
            "combo",
            "eod_bid_ask",
            "indicative"
          ],
          "title": "Quote Quality Required",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "optimistic",
            "base",
            "conservative",
            "stressed"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "short_entry_side": {
          "const": "bid",
          "title": "Short Entry Side",
          "type": "string"
        },
        "short_exit_side": {
          "const": "ask",
          "title": "Short Exit Side",
          "type": "string"
        },
        "slippage_per_contract_side": {
          "$ref": "#/$defs/GovernedValue"
        }
      },
      "required": [
        "scenario",
        "long_entry_side",
        "short_entry_side",
        "long_exit_side",
        "short_exit_side",
        "commission_per_contract_side",
        "slippage_per_contract_side",
        "quote_quality_required",
        "preview_only",
        "order_capability"
      ],
      "title": "ExecutionAssumptionsConfig",
      "type": "object"
    },
    "ExecutionEstimateStatus": {
      "enum": [
        "INDICATIVE",
        "ESTIMATED_CONFIGURED_EXECUTION_MODEL",
        "OBSERVED",
        "BLOCKED_MISSING_EXECUTION_DATA"
      ],
      "title": "ExecutionEstimateStatus",
      "type": "string"
    },
    "ExitCostModelConfiguration": {
      "additionalProperties": false,
      "properties": {
        "assignment_or_exercise_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignment Or Exercise Cost"
        },
        "closing_commission_multiplier": {
          "default": 1.0,
          "minimum": 0,
          "title": "Closing Commission Multiplier",
          "type": "number"
        },
        "fx_exit_cost_bps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Exit Cost Bps"
        },
        "slippage_cost_multiplier": {
          "default": 1.0,
          "minimum": 0,
          "title": "Slippage Cost Multiplier",
          "type": "number"
        },
        "spread_cost_multiplier": {
          "default": 1.0,
          "minimum": 0,
          "title": "Spread Cost Multiplier",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/ExecutionEstimateStatus",
          "default": "ESTIMATED_CONFIGURED_EXECUTION_MODEL"
        }
      },
      "title": "ExitCostModelConfiguration",
      "type": "object"
    },
    "FXHandlingMode": {
      "enum": [
        "CONVERT_AT_ENTRY_AND_EXIT",
        "MAINTAIN_UNDERLYING_CURRENCY_CASH",
        "ACCOUNT_BASE_TRANSLATION_ONLY",
        "UNKNOWN"
      ],
      "title": "FXHandlingMode",
      "type": "string"
    },
    "GovernedValue": {
      "additionalProperties": false,
      "description": "A value that cannot be mistaken for a universal default.",
      "properties": {
        "origin": {
          "enum": [
            "official_source",
            "authorized_market_data",
            "derived",
            "estimate",
            "user_assumption"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "sourced",
            "calibrated",
            "calibration_required",
            "draft_to_validate"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "origin",
        "status",
        "rationale"
      ],
      "title": "GovernedValue",
      "type": "object"
    },
    "GreekBumpConfiguration": {
      "additionalProperties": false,
      "properties": {
        "grid_levels": {
          "items": {
            "type": "integer"
          },
