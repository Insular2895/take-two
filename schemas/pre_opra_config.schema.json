          "title": "Maximum Spot Multiplier",
          "type": "number"
        },
        "minimum_spot_multiplier": {
          "default": 0.0,
          "minimum": 0,
          "title": "Minimum Spot Multiplier",
          "type": "number"
        },
        "pnl_tolerance": {
          "default": 0.0001,
          "exclusiveMinimum": 0,
          "title": "Pnl Tolerance",
          "type": "number"
        },
        "root_tolerance": {
          "default": 1e-05,
          "exclusiveMinimum": 0,
          "title": "Root Tolerance",
          "type": "number"
        }
      },
      "title": "BreakevenSolverConfiguration",
      "type": "object"
    },
    "CapitalConstraintsConfig": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "fx_rate_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate As Of"
        },
        "fx_rate_to_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate To Usd"
        },
        "maximum_contracts": {
          "exclusiveMinimum": 0,
          "title": "Maximum Contracts",
          "type": "integer"
        },
        "maximum_loss": {
          "exclusiveMinimum": 0,
          "title": "Maximum Loss",
          "type": "number"
        },
        "safety_reserve_fraction": {
          "$ref": "#/$defs/GovernedValue"
