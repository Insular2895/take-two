{
  "$defs": {
    "Architecture": {
      "enum": [
        "long_call",
        "long_put",
        "bull_call_spread",
        "bear_put_spread",
        "call_butterfly",
        "put_butterfly",
        "call_broken_wing_butterfly",
        "put_broken_wing_butterfly",
        "call_calendar",
        "put_calendar",
        "call_diagonal",
        "put_diagonal",
        "long_straddle",
        "long_strangle",
        "iron_condor"
      ],
      "title": "Architecture",
      "type": "string"
    },
    "CapitalConstraintsConfig": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "fx_rate_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate As Of"
        },
        "fx_rate_to_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate To Usd"
        },
        "maximum_contracts": {
          "exclusiveMinimum": 0,
          "title": "Maximum Contracts",
          "type": "integer"
        },
        "maximum_loss": {
          "exclusiveMinimum": 0,
          "title": "Maximum Loss",
          "type": "number"
        },
        "safety_reserve_fraction": {
          "$ref": "#/$defs/GovernedValue"
        }
      },
      "required": [
        "amount",
        "currency",
        "maximum_loss",
        "maximum_contracts",
        "safety_reserve_fraction"
      ],
      "title": "CapitalConstraintsConfig",
      "type": "object"
    },
    "ExecutionAssumptionsConfig": {
      "additionalProperties": false,
      "properties": {
        "commission_per_contract_side": {
          "$ref": "#/$defs/GovernedValue"
        },
        "long_entry_side": {
          "const": "ask",
          "title": "Long Entry Side",
          "type": "string"
        },
        "long_exit_side": {
          "const": "bid",
          "title": "Long Exit Side",
          "type": "string"
        },
        "order_capability": {
          "const": "forbidden",
          "title": "Order Capability",
          "type": "string"
        },
        "preview_only": {
          "const": true,
          "title": "Preview Only",
          "type": "boolean"
        },
        "quote_quality_required": {
          "enum": [
            "live_broker",
            "combo",
            "eod_bid_ask",
            "indicative"
          ],
          "title": "Quote Quality Required",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "optimistic",
            "base",
            "conservative",
            "stressed"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "short_entry_side": {
          "const": "bid",
          "title": "Short Entry Side",
          "type": "string"
        },
        "short_exit_side": {
          "const": "ask",
          "title": "Short Exit Side",
          "type": "string"
        },
        "slippage_per_contract_side": {
          "$ref": "#/$defs/GovernedValue"
        }
      },
      "required": [
        "scenario",
        "long_entry_side",
        "short_entry_side",
        "long_exit_side",
        "short_exit_side",
        "commission_per_contract_side",
        "slippage_per_contract_side",
        "quote_quality_required",
        "preview_only",
        "order_capability"
      ],
      "title": "ExecutionAssumptionsConfig",
      "type": "object"
    },
    "GovernedValue": {
      "additionalProperties": false,
      "description": "A value that cannot be mistaken for a universal default.",
      "properties": {
        "origin": {
          "enum": [
            "official_source",
            "authorized_market_data",
            "derived",
            "estimate",
            "user_assumption"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "sourced",
            "calibrated",
            "calibration_required",
            "draft_to_validate"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "origin",
        "status",
        "rationale"
      ],
      "title": "GovernedValue",
      "type": "object"
    },
    "MarketContextConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_cache_fallback": {
          "title": "Allow Cache Fallback",
          "type": "boolean"
        },
        "base_currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Base Currency",
          "type": "string"
        },
        "data_providers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Providers",
          "type": "array"
        },
        "decision_cutoff": {
          "format": "date-time",
          "title": "Decision Cutoff",
          "type": "string"
        },
        "historical_dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Dataset Id"
        },
        "maximum_data_age_days": {
          "$ref": "#/$defs/GovernedValue"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "decision_cutoff",
        "base_currency",
        "historical_dataset_id",
        "data_providers",
        "maximum_data_age_days",
        "allow_cache_fallback"
      ],
      "title": "MarketContextConfig",
      "type": "object"
    },
    "ModelDefinition": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/GovernedValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "status": {
          "enum": [
            "eligible",
            "experimental",
            "calibration_required",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "family",
        "status"
      ],
      "title": "ModelDefinition",
      "type": "object"
    },
    "ModelUniverseConfig": {
      "additionalProperties": false,
      "properties": {
        "model_addition_policy": {
          "const": "deficiency_and_validation_required",
          "title": "Model Addition Policy",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelDefinition"
          },
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "selection_policy": {
          "enum": [
            "pre_registered",
            "walk_forward_only"
          ],
          "title": "Selection Policy",
          "type": "string"
        }
      },
      "required": [
        "models",
        "selection_policy",
        "model_addition_policy"
      ],
      "title": "ModelUniverseConfig",
      "type": "object"
    },
    "OptimizationObjectiveConfig": {
      "additionalProperties": false,
      "properties": {
        "no_single_magic_score": {
          "const": true,
          "title": "No Single Magic Score",
          "type": "boolean"
        },
        "objective_type": {
          "enum": [
            "pareto_multi_objective",
            "maximize_probability_target_return"
          ],
          "title": "Objective Type",
          "type": "string"
        },
        "primary_metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Primary Metrics",
          "type": "array"
        },
        "secondary_ranking_weights": {
          "additionalProperties": {
            "$ref": "#/$defs/GovernedValue"
          },
          "title": "Secondary Ranking Weights",
          "type": "object"
        }
      },
      "required": [
        "objective_type",
        "primary_metrics",
        "no_single_magic_score"
      ],
      "title": "OptimizationObjectiveConfig",
      "type": "object"
    },
    "ReportPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "display_raw_metrics": {
          "const": true,
          "title": "Display Raw Metrics",
          "type": "boolean"
        },
        "display_score_components": {
          "const": true,
          "title": "Display Score Components",
          "type": "boolean"
        },
        "formats": {
          "items": {
            "enum": [
              "json",
              "markdown",
              "html"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "language": {
          "enum": [
            "fr",
            "en"
          ],
          "title": "Language",
          "type": "string"
        },
        "maximum_candidates": {
          "exclusiveMinimum": 0,
          "title": "Maximum Candidates",
          "type": "integer"
        },
        "score_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 5,
          "title": "Score Versions",
          "type": "object"
        }
      },
      "required": [
        "formats",
        "display_raw_metrics",
        "display_score_components",
        "maximum_candidates",
        "language",
        "score_versions"
      ],
      "title": "ReportPolicyConfig",
      "type": "object"
    },
    "ResearchRequestConfig": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "directional_thesis": {
          "enum": [
            "bullish",
            "bearish",
            "neutral",
            "volatile"
          ],
          "title": "Directional Thesis",
          "type": "string"
        },
        "invalidation_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Invalidation Conditions",
          "type": "array"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "thesis_summary": {
          "minLength": 1,
          "title": "Thesis Summary",
          "type": "string"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "ticker",
        "as_of",
        "directional_thesis",
        "thesis_summary",
        "invalidation_conditions"
      ],
      "title": "ResearchRequestConfig",
      "type": "object"
    },
    "RiskProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_missing_volume": {
          "title": "Allow Missing Volume",
          "type": "boolean"
        },
        "bounded_risk_only": {
          "const": true,
          "title": "Bounded Risk Only",
          "type": "boolean"
        },
        "large_loss_threshold": {
          "$ref": "#/$defs/GovernedValue"
        },
        "loss_ladder_thresholds": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Loss Ladder Thresholds",
          "type": "array"
        },
        "maximum_relative_spread": {
          "$ref": "#/$defs/GovernedValue"
        },
        "minimum_open_interest": {
          "$ref": "#/$defs/GovernedValue"
        },
        "minimum_volume": {
          "$ref": "#/$defs/GovernedValue"
        },
        "target_return": {
          "$ref": "#/$defs/GovernedValue"
        }
      },
      "required": [
        "bounded_risk_only",
        "loss_ladder_thresholds",
        "large_loss_threshold",
        "target_return",
        "maximum_relative_spread",
        "minimum_open_interest",
        "minimum_volume",
        "allow_missing_volume"
      ],
      "title": "RiskProfileConfig",
      "type": "object"
    },
    "ScenarioDefinition": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/GovernedValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "$ref": "#/$defs/GovernedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "label",
        "probability"
      ],
      "title": "ScenarioDefinition",
      "type": "object"
    },
    "ScenarioSetConfig": {
      "additionalProperties": false,
      "properties": {
        "probability_measure": {
          "enum": [
            "P",
            "Q",
            "none"
          ],
          "title": "Probability Measure",
          "type": "string"
        },
        "scenario_set_id": {
          "minLength": 1,
          "title": "Scenario Set Id",
          "type": "string"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioDefinition"
          },
          "minItems": 1,
          "title": "Scenarios",
          "type": "array"
        }
      },
      "required": [
        "scenario_set_id",
        "scenarios",
        "probability_measure"
      ],
      "title": "ScenarioSetConfig",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "format": "date",
          "title": "Accessed At",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "chapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "edition_or_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition Or Date"
        },
        "excerpt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt Hash"
        },
        "page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "book",
            "academic",
            "official",
            "company",
            "broker",
            "data_provider",
            "internal"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "title",
        "accessed_at",
        "source_type",
        "confidence"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "StrategyUniverseConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_structures": {
          "items": {
            "$ref": "#/$defs/Architecture"
          },
          "minItems": 1,
          "title": "Allowed Structures",
          "type": "array"
        },
        "expiration_source": {
          "const": "listed_chain",
          "title": "Expiration Source",
          "type": "string"
        },
        "forbidden_structures": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Structures",
          "type": "array"
        },
        "horizon_max_days": {
          "exclusiveMinimum": 0,
          "title": "Horizon Max Days",
          "type": "integer"
        },
        "horizon_min_days": {
          "exclusiveMinimum": 0,
          "title": "Horizon Min Days",
          "type": "integer"
        },
        "recipe_catalog_path": {
          "minLength": 1,
          "title": "Recipe Catalog Path",
          "type": "string"
        },
        "strike_source": {
          "const": "listed_chain",
          "title": "Strike Source",
          "type": "string"
        }
      },
      "required": [
        "allowed_structures",
        "horizon_min_days",
        "horizon_max_days",
        "strike_source",
        "expiration_source",
        "recipe_catalog_path"
      ],
      "title": "StrategyUniverseConfig",
      "type": "object"
    },
    "ValidationPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "embargo_days": {
          "minimum": 0,
          "title": "Embargo Days",
          "type": "integer"
        },
        "final_holdout_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Holdout Id"
        },
        "holdout_must_be_unopened": {
          "const": true,
          "title": "Holdout Must Be Unopened",
          "type": "boolean"
        },
        "minimum_economic_materiality": {
          "$ref": "#/$defs/GovernedValue"
        },
        "minimum_holdout_observations": {
          "exclusiveMinimum": 0,
          "title": "Minimum Holdout Observations",
          "type": "integer"
        },
        "minimum_test_observations": {
          "exclusiveMinimum": 0,
          "title": "Minimum Test Observations",
          "type": "integer"
        },
        "minimum_train_observations": {
          "exclusiveMinimum": 0,
          "title": "Minimum Train Observations",
          "type": "integer"
        },
        "minimum_validation_observations": {
          "exclusiveMinimum": 0,
          "title": "Minimum Validation Observations",
          "type": "integer"
        },
        "multiple_testing_method": {
          "enum": [
            "holm",
            "benjamini_hochberg"
          ],
          "title": "Multiple Testing Method",
          "type": "string"
        },
        "purge_days": {
          "minimum": 0,
          "title": "Purge Days",
          "type": "integer"
        },
        "require_oos": {
          "const": true,
          "title": "Require Oos",
          "type": "boolean"
        },
        "significance_level": {
          "$ref": "#/$defs/GovernedValue"
        },
        "walk_forward_method": {
          "enum": [
            "rolling",
            "expanding"
          ],
          "title": "Walk Forward Method",
          "type": "string"
        }
      },
      "required": [
        "require_oos",
        "walk_forward_method",
        "minimum_train_observations",
        "minimum_validation_observations",
        "minimum_test_observations",
        "minimum_holdout_observations",
        "purge_days",
        "embargo_days",
        "final_holdout_id",
        "holdout_must_be_unopened",
        "multiple_testing_method",
        "significance_level",
        "minimum_economic_materiality"
      ],
      "title": "ValidationPolicyConfig",
      "type": "object"
    }
  },
  "$id": "https://schemas.take-two-options.invalid/v11.1/pre_opra_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The eleven mandatory configuration groups and no execution capability.",
  "properties": {
    "capital_constraints": {
      "$ref": "#/$defs/CapitalConstraintsConfig"
    },
    "execution_assumptions": {
      "$ref": "#/$defs/ExecutionAssumptionsConfig"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "market_context": {
      "$ref": "#/$defs/MarketContextConfig"
    },
    "model_universe": {
      "$ref": "#/$defs/ModelUniverseConfig"
    },
    "optimization_objective": {
      "$ref": "#/$defs/OptimizationObjectiveConfig"
    },
    "report_policy": {
      "$ref": "#/$defs/ReportPolicyConfig"
    },
    "research_request": {
      "$ref": "#/$defs/ResearchRequestConfig"
    },
    "risk_profile": {
      "$ref": "#/$defs/RiskProfileConfig"
    },
    "scenario_set": {
      "$ref": "#/$defs/ScenarioSetConfig"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_universe": {
      "$ref": "#/$defs/StrategyUniverseConfig"
    },
    "validation_policy": {
      "$ref": "#/$defs/ValidationPolicyConfig"
    }
  },
  "required": [
    "schema_version",
    "research_request",
    "market_context",
    "capital_constraints",
    "risk_profile",
    "strategy_universe",
    "model_universe",
    "scenario_set",
    "execution_assumptions",
    "validation_policy",
    "optimization_objective",
    "report_policy"
  ],
  "title": "PreOpraConfig",
  "type": "object"
}
