      "type": "string"
    },
    "BreakevenSolverConfiguration": {
      "additionalProperties": false,
      "properties": {
        "grid_points": {
          "default": 401,
          "maximum": 5001,
          "minimum": 51,
          "title": "Grid Points",
          "type": "integer"
        },
        "maximum_iterations": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "maximum_spot_multiplier": {
          "default": 3.0,
