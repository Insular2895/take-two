{
  "$id": "https://schemas.take-two-options.invalid/v11.1/broker_what_if_observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Redacted transcription of broker output; never a request or an order.",
  "properties": {
    "account_scope_redacted": {
      "const": true,
      "default": true,
      "title": "Account Scope Redacted",
      "type": "boolean"
    },
    "broker_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Broker Status"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "commission": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commission"
    },
    "commission_currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commission Currency"
    },
    "currency": {
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    },
    "equity_with_loan_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equity With Loan After"
    },
    "equity_with_loan_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equity With Loan Before"
    },
    "equity_with_loan_change": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equity With Loan Change"
    },
    "example_only": {
      "default": true,
      "title": "Example Only",
      "type": "boolean"
    },
    "initial_margin_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Margin After"
    },
    "initial_margin_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Margin Before"
    },
    "initial_margin_change": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Margin Change"
    },
    "maintenance_margin_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Margin After"
    },
    "maintenance_margin_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Margin Before"
    },
    "maintenance_margin_change": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Margin Change"
    },
    "maximum_commission": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Commission"
    },
    "minimum_commission": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Commission"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "order_capability": {
      "const": "forbidden",
      "default": "forbidden",
      "title": "Order Capability",
      "type": "string"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "transmit": {
      "const": false,
      "default": false,
      "title": "Transmit",
      "type": "boolean"
    },
    "warning_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warning Text"
    },
    "what_if": {
      "const": true,
      "default": true,
      "title": "What If",
      "type": "boolean"
    }
  },
  "required": [
    "candidate_id",
    "observed_at",
    "source_id",
    "currency"
  ],
  "title": "BrokerWhatIfObservation",
  "type": "object"
}
