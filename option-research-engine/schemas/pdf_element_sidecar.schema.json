{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.take-two/schemas/pdf_element_sidecar.schema.json",
  "title": "Canonical PDF element sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "page",
    "element",
    "extraction",
    "confidence",
    "alerts",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "pdf_sha256", "pipeline_version"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "pipeline_version": {"type": "string", "minLength": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_page_id",
        "pdf_page_index",
        "pdf_page_number",
        "printed_page_raw",
        "printed_page_normalized",
        "printed_page_confidence"
      ],
      "properties": {
        "document_page_id": {"type": "string"},
        "pdf_page_index": {"type": "integer", "minimum": 0},
        "pdf_page_number": {"type": "integer", "minimum": 1},
        "printed_page_raw": {"type": ["string", "null"]},
        "printed_page_normalized": {"type": ["integer", "string", "null"]},
        "printed_page_confidence": {"$ref": "#/$defs/score"},
        "chapter": {"type": ["string", "null"]},
        "section": {"type": ["string", "null"]}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "type", "bbox", "source_rotation", "applied_rotation", "dpi"],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "text",
            "table",
            "formula",
            "figure",
            "chart",
            "payoff_diagram",
            "page_number",
            "artifact",
            "unknown"
          ]
        },
        "number": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "source_rotation": {"enum": [0, 90, 180, 270]},
        "applied_rotation": {"enum": [0, 90, 180, 270]},
        "dpi": {"type": "integer", "minimum": 72}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_text", "ocr_text", "normalized_text", "cells", "formula", "figure"],
      "properties": {
        "native_text": {"type": ["string", "null"]},
        "ocr_text": {"type": ["string", "null"]},
        "normalized_text": {"type": ["string", "null"]},
        "cells": {
          "type": "array",
          "items": {"$ref": "#/$defs/cell"}
        },
        "formula": {"type": ["object", "null"], "additionalProperties": true},
        "figure": {"type": ["object", "null"], "additionalProperties": true}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "layout",
        "table_structure",
        "numeric",
        "formula",
        "page_mapping",
        "gemini_visual_agreement",
        "codex_fallback_agreement",
        "business_validation"
      ],
      "properties": {
        "text": {"$ref": "#/$defs/score"},
        "layout": {"$ref": "#/$defs/score"},
        "table_structure": {"$ref": "#/$defs/score"},
        "numeric": {"$ref": "#/$defs/score"},
        "formula": {"$ref": "#/$defs/score"},
        "page_mapping": {"$ref": "#/$defs/score"},
        "gemini_visual_agreement": {"$ref": "#/$defs/score"},
        "codex_fallback_agreement": {"$ref": "#/$defs/score"},
        "business_validation": {"$ref": "#/$defs/score"}
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["info", "warning", "blocking"]},
          "message": {"type": "string"},
          "location": {"type": ["object", "null"], "additionalProperties": true}
        }
      }
    },
    "status": {"$ref": "#/$defs/status"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "extractor_versions", "prompt_version", "review_history"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "extractor_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "prompt_version": {"type": ["string", "null"]},
        "review_history": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    }
  },
  "$defs": {
    "score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "status": {
      "enum": [
        "machine_verified",
        "machine_verified_with_visual_check",
        "machine_reviewed",
        "needs_visual_review",
        "human_verified",
        "human_review_required",
        "blocked",
        "unextractable",
        "image_only"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "raw_ocr",
        "normalized_text",
        "numeric_value",
        "sign",
        "decimal_digits",
        "bbox",
        "ocr_confidence",
        "visual_candidates",
        "visual_confidence",
        "final_status"
      ],
      "properties": {
        "row": {"type": ["integer", "string"]},
        "column": {"type": ["integer", "string"]},
        "raw_ocr": {"type": ["string", "null"]},
        "normalized_text": {"type": ["string", "null"]},
        "numeric_value": {"type": ["number", "null"]},
        "sign": {"enum": ["+", "-", "none", "ambiguous", null]},
        "decimal_digits": {"type": ["integer", "null"], "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "ocr_confidence": {"$ref": "#/$defs/score"},
        "visual_candidates": {
          "type": "array",
          "items": {"type": ["string", "number", "null"]}
        },
        "visual_confidence": {"$ref": "#/$defs/score"},
        "final_status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
