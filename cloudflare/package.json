{
  "name": "take-two-cloudflare-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/safety-scan.mjs",
    "action-password:set": "node scripts/set-action-password.mjs",
    "action-password:set-local": "node scripts/set-action-password.mjs --local-only",
    "db:local": "wrangler d1 migrations apply take-two-control --local",
    "db:remote": "wrangler d1 migrations apply take-two-control --remote",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.12",
    "@cloudflare/workers-types": "5.20260917.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  }
}
